<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TableTennisLive_WinUI.MiniScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迷你比分 · Table Tennis Live">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="20" RowSpacing="12" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="●  迷你比分" FontSize="17" FontWeight="SemiBold" />
        <ComboBox x:Name="MatchSelect" Grid.Row="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Candidates}" SelectionChanged="MatchSelect_SelectionChanged"
                  PlaceholderText="暂无直播或已收藏比赛">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="2" Text="{Binding Selected.Competition}" TextWrapping="Wrap"
                   FontSize="12" Opacity="0.65" />
        <StackPanel Grid.Row="3" Spacing="10" Margin="0,8,0,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Selected.PlayerAWithFlag}" FontSize="14"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.Score}" FontSize="30"
                           FontWeight="Bold" MinWidth="100" TextAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Selected.PlayerBWithFlag}"
                           FontSize="14" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Selected.Sets}" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.7" />
            <TextBlock Text="{Binding Selected.Status}" TextAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Row="4" Content="查看比赛详情 ↗" HorizontalAlignment="Stretch"
                Click="OpenDetail_Click" />
    </Grid>
</Window>
